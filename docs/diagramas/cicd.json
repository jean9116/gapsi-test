  "edges": [
    {
      "from": "pr",
      "to": "merge"
    },
    {
      "from": "pr",
      "to": "tf_plan",
      "label": "plan ×3",
      "role": "branch"
    },
    {
      "from": "merge",
      "to": "tf_apply",
      "label": "terraform/**",
      "role": "branch"
    },
    {
      "from": "merge",
      "to": "build",
      "label": "app/**",
      "variant": "emphasis"
    },
    {
      "from": "build",
      "to": "trivy",
      "label": "escanea"
    },
    {
      "from": "trivy",
      "to": "push",
      "label": "limpio",
      "variant": "emphasis"
    },
    {
      "from": "push",
      "to": "deploy_dev",
      "label": "digest",
      "variant": "emphasis"
    },
    {
      "from": "deploy_dev",
      "to": "promote_qa"
    },
    {
      "from": "promote_qa",
      "to": "promote_prod",
      "variant": "security"
    },
    {
      "from": "trivy",
      "to": "stopped",
      "label": "CVE",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "deploy_dev",
      "to": "rollback",
      "label": "smoke falla",
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Gates",
      "items": [
        "PR: fmt, tflint, checkov, terraform test y plan de los 3 ambientes",
        "Build: Trivy corta con CVE CRITICAL"
      ]
    },
    {
      "dot": "amber",
      "title": "Promoción",
      "items": [
        "qa y prod despliegan el mismo digest probado en dev",
        "Terraform y app en prod exigen aprobación"
      ]
    },
    {
      "dot": "rose",
      "title": "Recuperación",
      "items": [
        "Migraciones antes de mover tráfico",
        "Smoke fallido: tráfico a la revisión anterior en cualquier ambiente"
      ]
    }
  ]
}