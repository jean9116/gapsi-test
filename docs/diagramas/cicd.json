        "frontend": {
          "label": "GitHub"
        },
        "backend": {
          "label": "Build"
        },
        "security": {
          "label": "Gate / control"
        },
        "messagebus": {
          "label": "Recuperación"
        },
        "database": {
          "label": "Registro"
        },
        "cloud": {
          "label": "Despliegue"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "git",
      "label": "GitHub · desarrollador"
    },
    {
      "id": "cb",
      "label": "Cloud Build · Terraform y aplicación"
    },
    {
      "id": "lower",
      "label": "Cloud Run · dev → qa → prod"
    },
    {
      "id": "fail",
      "label": "Fallo y rollback",
