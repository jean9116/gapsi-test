      "width": 150
    },
    {
      "id": "merge",
      "lane": "git",
      "col": 1,
      "type": "frontend",
      "label": "Merge a main",
      "sublabel": "revisado",
      "brand": "github",
      "width": 150
    },
    {
      "id": "tf_plan",
      "lane": "cb",
      "col": 0,
      "type": "security",
