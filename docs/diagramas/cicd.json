      "brand": "terraform",
      "width": 150
    },
    {
      "id": "tf_apply",
      "lane": "cb",
      "col": 5,
      "type": "cloud",
      "label": "pprov-tf-apply",
      "sublabel": "dev auto · qa/prod aprobación",
